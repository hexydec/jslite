{
    "name": "hexydec/jslite",
    "description": "A token based Javascript parser/minifier designed for compressing inline scripts on the fly, written in PHP",
    "type": "library",
    "license": "MIT",
	"homepage": "https://github.com/hexydec/jslite",
    "authors": [
        {
            "name": "Will Earp",
            "email": "will@hexydec.com",
			"homepage": "https://github.com/hexydec"
        }
    ],
	"keywords": ["js", "javascript", "minifier", "minify", "parser", "compiler"],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.4",
		"hexydec/tokenise": "1.0.4"
	},
	"autoload": {
		"classmap": ["src/"]
	},
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "phpstan/phpstan": "^2.0"
    }
}
